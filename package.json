{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build-programs-csv.mjs && vite build",
    "build:programs": "node scripts/build-programs-csv.mjs",
    "preview": "vite preview",
    "dev:emulator": "npx -y firebase-tools@latest emulators:start --only auth,firestore,functions,storage,hosting",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore,functions,storage,hosting",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project rands-local \"node --test tests/rules/firestore.rules.test.mjs\"",
    "test:storage": "npx -y firebase-tools@latest emulators:exec --only storage --project rands-local \"node --test tests/rules/storage.rules.test.mjs\"",
    "test": "node --import tsx --test tests/unit/*.test.mjs",
    "seed:emulator": "node tests/fixtures/seed-emulator.mjs",
    "hosting:deploy": "npm run build && node scripts/deploy-hosting.mjs deploy",
    "hosting:preview": "npm run build && node scripts/deploy-hosting.mjs preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@intl-tel-input/react": "^29.1.2",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "mailcheck": "^1.1.1",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^13.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
