# Firebase Web configuration for a non-production project.
# Copy to .env.local and replace every placeholder before running Vite.
VITE_FIREBASE_API_KEY=replace-with-non-production-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-non-production-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-non-production-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-non-production-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-non-production-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-non-production-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-non-production-measurement-id

# Do not place RESEND_API_KEY or service-account credentials in this file.
