# Local-first Firebase Web configuration. These values are non-secret placeholders
# for the local Emulator Suite. Replace them with an isolated staging app config
# only when VITE_USE_FIREBASE_EMULATORS is set to false deliberately.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=local-emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=rands-local
VITE_FIREBASE_STORAGE_BUCKET=rands-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=local-emulator-sender
VITE_FIREBASE_APP_ID=local-emulator-app
VITE_FIREBASE_MEASUREMENT_ID=
# Required only for an approved non-emulator environment whose callable Functions enforce App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Do not place RESEND_API_KEY or service-account credentials in this file.
