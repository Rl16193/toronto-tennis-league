{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "3010",
        "--host",
        "0.0.0.0"
      ],
      "port": 3010
    },
    {
      "name": "dev-emulators",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:VITE_USE_EMULATORS='true'; npx vite --port 3020 --strictPort"
      ],
      "port": 3020
    },
    {
      "name": "dev-emulators-demo",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:VITE_USE_EMULATORS='true'; $env:VITE_FIREBASE_PROJECT_ID='demo-ttl'; npx vite --port 3030 --strictPort"
      ],
      "port": 3030
    },
    {
      "name": "dev-attach",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
