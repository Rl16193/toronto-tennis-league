rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid == "7PvfzNtDmsOq5GLMieId7QRT7wH3";
    }

    function isGlobalEventCreator() {
      return isAuthenticated() &&
        (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/preferences/$(request.auth.uid)).data.event_creator == true
        );
    }

    function isCreatorOfEvent(eventId) {
      return isAuthenticated() &&
        (
          isGlobalEventCreator() ||
          get(/databases/$(database)/documents/events/$(eventId)).data.creator_id == request.auth.uid
        );
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ===============================================================
    // Stats Collection
    // ===============================================================
    match /stats/{userId} {
      allow read: if true;
      // Owners may self-create only an all-zero scoring baseline (signup / bootstrap).
      allow create: if isGlobalEventCreator() ||
        (isOwner(userId) &&
          request.resource.data.leaguePoints26 == 0 &&
          request.resource.data.wins == 0 &&
          request.resource.data.loses == 0 &&
          request.resource.data.matchesPlayed == 0 &&
          request.resource.data.tournamentsPlayed == 0);
      // Owners may only edit profile fields (league = the Men's/Women's division they play in);
      // scoring fields are organizer-only.
      allow update: if isGlobalEventCreator() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['skill_level', 'tournament_preference', 'name', 'user_id', 'league']));
      allow delete: if false;
    }

    // ===============================================================
    // Preferences Collection
    // ===============================================================
    match /preferences/{userId} {
      allow read: if true;
      // event_creator may never be self-granted — only the super admin sets it.
      allow create: if isOwner(userId) && request.resource.data.event_creator == false;
      allow update: if isSuperAdmin() ||
        (isOwner(userId) &&
          request.resource.data.event_creator == resource.data.event_creator);
      allow delete: if false;
    }

    // ===============================================================
    // Events Collection
    // ===============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isGlobalEventCreator();
      allow delete: if false;
    }

    // ===============================================================
    // Site Stats (public homepage counters — written by Admin scripts only)
    // ===============================================================
    match /site_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Task Progress (self-serve community tasks — Tasks tab)
    // ===============================================================
    match /task_progress/{userId} {
      // World-readable: the Community leaderboard ranks everyone's task points, logged out too.
      allow read: if true;
      // Owners mark their own tasks (profile task is client-gated on a complete profile; the
      // social tasks are trust-based). Organizers may un-mark (revoke) falsely-claimed tasks.
      allow create, update: if isOwner(userId) || isGlobalEventCreator();
      allow delete: if false;
    }

    // ===============================================================
    // Event Participants
    // ===============================================================
    match /event_participants/{docId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        (
          request.resource.data.user_id == request.auth.uid ||
          isCreatorOfEvent(request.resource.data.event_id)
        ) &&
        request.resource.data.event_id is string &&
        request.resource.data.created_at is string;

      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;

      allow delete: if isAuthenticated() &&
        (resource.data.user_id == request.auth.uid || isCreatorOfEvent(resource.data.event_id));
    }

    // ===============================================================
    // Tournament Matches (draw + results)
    // ===============================================================
    match /tournament_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isCreatorOfEvent(request.resource.data.event_id);
      // Organizer may edit anything; the two match players may edit ONLY the scheduling fields
      // (propose/confirm/reschedule/ask-organizer). Scores, players and advancement stay
      // organizer-only.
      allow update: if isCreatorOfEvent(resource.data.event_id)
        || (
          isAuthenticated()
          && (request.auth.uid == resource.data.player_1_user_id || request.auth.uid == resource.data.player_2_user_id)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['schedule_status', 'proposed_date', 'proposed_slot', 'proposed_by', 'schedule_requested'])
        );
      allow delete: if isCreatorOfEvent(resource.data.event_id);
    }

    // ===============================================================
    // Score Submissions (player-submitted scores, pending creator confirm)
    // ===============================================================
    match /score_submissions/{docId} {
      allow read: if isAuthenticated();

      // A submission is only a *request* — the event creator confirms it before it counts,
      // so the creator is the integrity gate. We require a signed-in user submitting as
      // themselves; the client gates who can see the Submit button (match players/teammates).
      allow create: if isAuthenticated() &&
        request.resource.data.submitted_by == request.auth.uid &&
        request.resource.data.event_id is string &&
        request.resource.data.match_id is string;

      // The submitter may retract; the event creator confirms/rejects by deleting.
      allow delete: if isAuthenticated() &&
        (
          resource.data.submitted_by == request.auth.uid ||
          isCreatorOfEvent(resource.data.event_id)
        );

      allow update: if false;
    }

    // ===============================================================
    // League Ladder challenges (head-to-head; organizer confirms the ±3 into leaguePoints26)
    // ===============================================================
    match /ladder_challenges/{id} {
      allow read: if isAuthenticated();

      // A player opens a challenge as themselves.
      allow create: if isAuthenticated() &&
        request.resource.data.challenger_id == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.event_id is string &&
        request.resource.data.opponent_id is string;

      // Opponent accepts/declines an open challenge (status -> 'accepted'/'rejected'). Either
      // participant may report the result once accepted (status -> 'reported', no points move
      // yet); only the event organizer may confirm/reject. Points land via the organizer's stats
      // write.
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.opponent_id &&
          resource.data.status == 'open' &&
          request.resource.data.status in ['accepted', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responded_at'])
        ) ||
        (
          (request.auth.uid == resource.data.challenger_id || request.auth.uid == resource.data.opponent_id) &&
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'reported' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'claimed_winner_id', 'claimed_winner_name', 'score_line', 'court', 'reported_by', 'reported_at'])
        ) ||
        isCreatorOfEvent(resource.data.event_id)
      );

      // Challenger may retract an open challenge; organizer may clean up.
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.challenger_id ||
        isCreatorOfEvent(resource.data.event_id)
      );
    }

    // ===============================================================
    // Ranking history (written by the snapshot-ranks Admin script only)
    // ===============================================================
    match /ranking_history/{userId}/entries/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Court Suggestions — legacy collection, retained read-only for historical data.
    // "Suggest an Improvement" was merged into Court Reports ("Submit a Photo"); nothing writes
    // here anymore.
    // ===============================================================
    match /court_suggestions/{id} {
      allow create: if false;
      allow read, update, delete: if isGlobalEventCreator();
    }

    // ===============================================================
    // Rallies (friendly-match requests — no points, no organizer step)
    // ===============================================================
    match /rallies/{id} {
      allow read: if isAuthenticated();
      // Sender creates an open rally addressed to someone else.
      allow create: if isAuthenticated() &&
        request.resource.data.from_id == request.auth.uid &&
        request.resource.data.to_id is string &&
        request.resource.data.to_id != request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.created_at is string;
      // Only the recipient responds, and only by settling the status.
      allow update: if isAuthenticated() &&
        resource.data.to_id == request.auth.uid &&
        resource.data.status == 'open' &&
        request.resource.data.status in ['accepted', 'declined'] &&
        request.resource.data.from_id == resource.data.from_id &&
        request.resource.data.to_id == resource.data.to_id;
      // Sender may retract an open rally.
      allow delete: if isAuthenticated() &&
        resource.data.from_id == request.auth.uid &&
        resource.data.status == 'open';
    }

    // ===============================================================
    // Mailing list (optional opt-in offered to anonymous suggestion submitters)
    // ===============================================================
    match /mailing_list/{id} {
      // Anyone (incl. logged-out) may join; no client ever needs to read the list back.
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() < 320;
      allow read, update, delete: if isGlobalEventCreator();
    }

    // ===============================================================
    // Notifications (bell feed — created server-side only)
    // ===============================================================
    match /notifications/{id} {
      // Created exclusively by Cloud Functions (Admin SDK bypasses these rules). Clients may
      // never create: otherwise any signed-in player could write into another player's feed.
      allow create: if false;
      // Only the recipient may read their own, and may only flip `read` (never rewrite the
      // content of a notification addressed to them).
      allow read: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.recipient_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at']);
      allow delete: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
    }

    // ===============================================================
    // Court Visits (check-in "passport" — one stamp per player per court)
    // ===============================================================
    match /court_visits/{id} {
      allow read: if isAuthenticated();
      // Deterministic id ({uid}_{courtKey}) — a create can only ever happen once per court per
      // player; a second attempt is an update, which has no matching rule and is denied.
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        id.matches(request.auth.uid + '_.*') &&
        request.resource.data.court_key is string &&
        request.resource.data.dist_m is number &&
        request.resource.data.dist_m <= 400 &&
        request.resource.data.created_at is string;
      allow update, delete: if false;
    }

    // ===============================================================
    // Court Attendance (append-only daily check-in log — feeds Matchday + zone sweeps)
    // ===============================================================
    match /court_attendance/{id} {
      allow read: if isAuthenticated();
      // id is {uid}_{courtKey}_{YYYYMMDD}: a repeat check-in the same day overwrites its own
      // entry (an update), so distinct-player counts stay accurate. Both create and update are
      // gated to the owner's own doc.
      allow create, update: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        id.matches(request.auth.uid + '_.*') &&
        request.resource.data.court_key is string &&
        request.resource.data.dist_m is number &&
        request.resource.data.dist_m <= 400 &&
        request.resource.data.created_at is string;
      allow delete: if false;
    }

    // ===============================================================
    // Group award ledger + zone-sweep history (written only by Cloud Functions / Admin SDK)
    // ===============================================================
    match /group_awards/{id} {
      // The bonus itself lands on task_progress.bonusPoints; this ledger is server-internal.
      allow read, write: if false;
    }
    match /zone_sweeps/{id} {
      // Community coverage timing — safe to surface publicly.
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Court Reports ("Submit a Photo" — the unified report/suggestion flow)
    // ===============================================================
    match /court_reports/{id} {
      allow read: if isAuthenticated();
      // Anyone (incl. logged-out) may submit — no organizer review step, every report
      // auto-approves at creation. Cloud Functions still run automated image moderation and can
      // flip status to 'rejected' after the fact if the photo is unsafe.
      allow create: if
        request.resource.data.type in ['condition', 'waitingBoard', 'queue'] &&
        request.resource.data.court_key is string &&
        request.resource.data.photo_paths is list &&
        request.resource.data.note is string &&
        request.resource.data.note.size() > 0 &&
        request.resource.data.status == 'approved' &&
        (
          (isAuthenticated() && request.resource.data.user_id == request.auth.uid) ||
          request.resource.data.user_id == null
        );
      // Cloud Functions (Admin SDK) flip status on moderation — Admin SDK bypasses these rules
      // entirely, so no separate allowance is needed for it. No client-side update path remains
      // now that organizer review is gone.
      allow update: if false;
      allow delete: if false;
    }

    // ===============================================================
    // Task Claims (Volunteer / Ambassador / Host — organizer-approved before they count)
    // ===============================================================
    match /task_claims/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.type in ['volunteer', 'ambassador', 'host'] &&
        request.resource.data.status == 'pending';
      allow update: if isGlobalEventCreator();
      allow delete: if false;
    }

    // ===============================================================
    // Round Robin drafts (creator's pre-generation group arrangement + withdrawals)
    // ===============================================================
    match /rr_drafts/{id} {
      allow read: if isAuthenticated();
      // Only the event's creator may write the draft. Covers create/update (event_id in the
      // incoming data) and delete (event_id on the existing doc).
      allow write: if isAuthenticated() &&
        (
          (request.resource != null && isCreatorOfEvent(request.resource.data.event_id)) ||
          (resource != null && isCreatorOfEvent(resource.data.event_id))
        );
    }

    // Deferred (built with the Messages release): player conduct reports
    // { reporter_uid, match_id, opponent_uid, reason, detail, created_at, status } — organizer read only.
    // match /player_reports/{id} {
    //   allow create: if isAuthenticated() && request.resource.data.reporter_uid == request.auth.uid;
    //   allow read, update, delete: if isGlobalEventCreator();
    // }

  }
}
