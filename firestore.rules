rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid == "7PvfzNtDmsOq5GLMieId7QRT7wH3";
    }

    // Roles live on providers/{uid}.roles (stringer | coach | organizer); the doc id is the member's uid.
    // Same rule as rolesOf()/isOrganizer() in functions/lib/roles.js — change both together.
    function hasRole(uid, role) {
      return exists(/databases/$(database)/documents/providers/$(uid)) &&
        role in get(/databases/$(database)/documents/providers/$(uid)).data.roles;
    }

    function isOrganizerRole() {
      return isAuthenticated() && (isSuperAdmin() || hasRole(request.auth.uid, 'organizer'));
    }

    // An event's managers: the super admin and its organizer_ids (the creator first).
    function isEventManager(eventId) {
      return isAuthenticated() && (isSuperAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.get('organizer_ids', []));
    }

    // The full contacts shape — all owner data, no points, so every field is safely self-writable.
    function ownerContactFields() {
      return ['email', 'phone', 'preferred_mode_of_contact', 'whatsapp_contact', 'contactable', 'updated_at', 'secondary_email', 'consent_at', 'lastActive'];
    }

    // Order-independent id for a pair of players. MUST match pairId() in functions/connections.js
    // exactly — the trigger writes the doc, this recomputes the same name to look it up.
    function pairId(a, b) {
      return a < b ? a + '__' + b : b + '__' + a;
    }

    // "These two may reach each other": an accepted rally/challenge, a tournament fixture, a
    // booking, or both looking for a doubles partner in one event and division. Server-written only.
    function isConnectedTo(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/connections/$(pairId(request.auth.uid, userId)));
    }

    // Someone who has invited contact by posting a marketplace listing (onListingContact marker).
    function hasPublicContact(userId) {
      return exists(/databases/$(database)/documents/public_contacts/$(userId));
    }

    // The counters and balances on stats that only the server writes (commitPoints, task triggers,
    // group awards, rewards, rank snapshot). A new stats doc must start them all at zero.
    function zeroCounters(d) {
      return d.leaguePoints == 0 && d.leaguePointsPrev == 0 && d.rsPoints == 0 && d.pointsSpent == 0 &&
        d.matchesPlayed == 0 && d.wins == 0 && d.pointswon == 0 && d.totalPointsPlayed == 0 &&
        d.tournamentsPlayed == 0 && d.eventsJoined == 0 && d.challengesPlayed == 0 && d.challengesWon == 0 &&
        d.courtsVisited == 0 && d.zoneComplete == 0 && d.suggestions == 0 && d.boardPhotos == 0 &&
        d.queueUpdates == 0 && d.currentStreak == 0 && d.bestStreak == 0 && d.monthsActive == 0 &&
        d.volunteerClaimed == 0 && d.volunteerApproved == 0 && d.inviteClaimed == 0 && d.inviteApproved == 0 &&
        d.hostClaimed == 0 && d.hostApproved == 0 && d.active_months.size() == 0;
    }

    // The member's own one-time task states (self-reported); an organizer may take one back.
    function selfReported() {
      return ['profilePhoto', 'profileComplete', 'whatsappGroup', 'followSocial', 'tagPost'];
    }

    // ===============================================================
    // Users — world-readable, so NEVER any contact detail (hasOnly keeps email/phone out).
    // ===============================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'bio', 'display_badges', 'created_at']);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'bio', 'display_badges']);
      allow delete: if false;
    }

    // ===============================================================
    // Contacts — readable by the owner, a connection, organizers, or a public-contact marker.
    // ===============================================================
    match /contacts/{userId} {
      allow read: if isOwner(userId) ||
        isConnectedTo(userId) ||
        isOrganizerRole() ||
        (isAuthenticated() && (hasRole(userId, 'organizer') || hasPublicContact(userId)));
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(ownerContactFields());
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerContactFields());
      allow delete: if false;
    }

    // ===============================================================
    // Stats — scoring record + task counters + points spent. Server-written except profile fields.
    // ===============================================================
    match /stats/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && zeroCounters(request.resource.data);
      allow update: if (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['skill_level', 'name', 'uid', 'league', 'updated_at'].concat(selfReported()))) ||
        (isOrganizerRole() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated_at'].concat(selfReported())));
      allow delete: if false;
    }

    // ===============================================================
    // Preferences — playing preferences only (roles moved to providers).
    // ===============================================================
    match /preferences/{userId} {
      // custom_courts: typed courts not on the roster, a list when present.
      function customCourtsOk() {
        return !('custom_courts' in request.resource.data) || request.resource.data.custom_courts is list;
      }
      // Members only: courts, availability and favourites together say where and when someone plays.
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && customCourtsOk() &&
        request.resource.data.keys().hasOnly(['uid', 'preferred_courts', 'custom_courts', 'preferred_zone',
          'favourite_players', 'availability_tags', 'email_notifications']);
      allow update: if (isOwner(userId) && customCourtsOk() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferred_courts', 'custom_courts',
            'preferred_zone', 'favourite_players', 'availability_tags', 'email_notifications'])) ||
        // An organizer's Change Zone overwrites the member's zone (the member's next court edit recomputes it).
        (isOrganizerRole() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferred_zone']));
      allow delete: if false;
    }

    // ===============================================================
    // Providers — roles (stringer | coach | organizer). Only the super admin grants them.
    // ===============================================================
    match /providers/{uid} {
      allow read: if true;
      allow write: if isSuperAdmin();
      // A provider may change their own business name and area (the offer form); roles stay the super admin's.
      allow update: if isAuthenticated() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'area']);
    }

    // ===============================================================
    // Events — managed by their organizer_ids; only the super admin changes that list.
    // ===============================================================
    match /events/{eventId} {
      allow read: if true;
      // A new event starts active; cancelling (status 'cancelled' + cancelled_at) is an update.
      allow create: if isOrganizerRole() &&
        request.resource.data.status == 'active' && request.resource.data.cancelled_at == null &&
        (isSuperAdmin() || request.resource.data.organizer_ids == [request.auth.uid]);
      allow update: if isEventManager(eventId) &&
        (isSuperAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizer_ids']));
      allow delete: if false;
    }

    // Organizer's pre-Generate RR edits. SUBCOLLECTION: rules do not cascade, so it needs its own path.
    match /events/{eventId}/rr_drafts/{drawKey} {
      allow read: if isAuthenticated();
      allow write: if isEventManager(eventId);
    }

    // ===============================================================
    // Public / server-only collections
    // ===============================================================
    match /site_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Served Up photo focus points, one doc per issue. Public read; the super admin only writes.
    match /newsletter/{issueId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['issue', 'focus', 'updated_at'])
        && request.resource.data.issue is int
        && request.resource.data.focus is map;
    }

    match /admin_stats/{docId} {
      allow read: if isOrganizerRole();
      allow write: if false;
    }

    match /ranking_history/{userId}/entries/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /league_seasons/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /awards/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Every score entry and the points it paid, written only by scoreMatch. Readable by members;
    // never editable by a client.
    match /submissions/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===============================================================
    // Event Participants — one row per member per event: {eventId}_{uid}, doubles
    // {eventId}_{uid}_{mensdoubles|womensdoubles|mixeddoubles}. Guests (guest_…) are added by managers.
    // ===============================================================
    match /event_participants/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.uid == request.auth.uid || isEventManager(request.resource.data.event_id)) &&
        docId.matches(request.resource.data.event_id + '_' + request.resource.data.uid + '(_(mens|womens|mixed)doubles)?') &&
        request.resource.data.status == 'active' &&
        request.resource.data.created_at is timestamp &&
        // Nobody joins a cancelled event, organizers included.
        get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('status', 'active') != 'cancelled' &&
        // A private event is invitation only: only its managers add players.
        (isEventManager(request.resource.data.event_id) ||
          get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.get('private', false) != true);
      allow update: if isAuthenticated() &&
        (
          isEventManager(resource.data.event_id) ||
          (
            resource.data.uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_name', 'skill', 'partner_uid', 'partner_name'])
          ) ||
          // The member withdraws themselves, with a reason.
          (
            resource.data.uid == request.auth.uid &&
            resource.data.status == 'active' && request.resource.data.status == 'withdrawn' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawn_reason', 'withdrawn_at', 'withdrawn_by']) &&
            request.resource.data.withdrawn_reason in ['wrong_zone', 'unavailable', 'other'] &&
            request.resource.data.withdrawn_at is timestamp &&
            request.resource.data.withdrawn_by == request.auth.uid
          ) ||
          // The member rejoins on the same row, under the same conditions as a new join.
          (
            resource.data.uid == request.auth.uid &&
            resource.data.status == 'withdrawn' && request.resource.data.status == 'active' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawn_reason', 'withdrawn_at', 'withdrawn_by', 'division', 'skill', 'partner_uid', 'partner_name', 'user_name']) &&
            request.resource.data.withdrawn_reason == '' && request.resource.data.withdrawn_at == null && request.resource.data.withdrawn_by == '' &&
            get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.get('status', 'active') != 'cancelled' &&
            get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.get('private', false) != true
          )
        );
      // Registrations are withdrawn, never deleted, by members.
      allow delete: if isAuthenticated() && isEventManager(resource.data.event_id);
    }

    // ===============================================================
    // Matches — fixture, placement and lifecycle. The result is the scoreMatch function's:
    // no client writes winner_uid or a completed status.
    // ===============================================================
    match /matches/{matchId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && request.resource.data.winner_uid == '' && (
        // A player opens their own rally / challenge.
        (
          request.resource.data.category in ['rally', 'challenge'] &&
          request.resource.data.player_1_uid == request.auth.uid &&
          request.resource.data.status == 'open'
        ) ||
        // An organizer builds a draw. Fixtures are created accepted (unplayed).
        (
          request.resource.data.category == 'tournament' &&
          isEventManager(request.resource.data.event_id) &&
          request.resource.data.status == 'accepted'
        )
      );

      allow update: if isAuthenticated() && (
        // Recipient accepts or declines a still-open rally or challenge.
        (
          resource.data.category in ['rally', 'challenge'] &&
          resource.data.status == 'open' &&
          request.auth.uid == resource.data.player_2_uid &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responded_at', 'updated_at'])
        ) ||
        // An organizer edits the draw (players, slots, groups), never a result or the status.
        (
          resource.data.category == 'tournament' &&
          isEventManager(resource.data.event_id) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['winner_uid', 'status'])
        )
      );

      allow delete: if isAuthenticated() && (
        // Sender retracts an open request; once accepted, either player may call it off until a result.
        (
          resource.data.category in ['rally', 'challenge'] &&
          (
            (resource.data.status == 'open' && request.auth.uid == resource.data.player_1_uid) ||
            (resource.data.status == 'accepted' && resource.data.winner_uid == '' &&
              (request.auth.uid == resource.data.player_1_uid || request.auth.uid == resource.data.player_2_uid))
          )
        ) ||
        (resource.data.category == 'tournament' && isEventManager(resource.data.event_id))
      );
    }

    // ===============================================================
    // Courts — visits (one per player per court per day) and reports.
    // ===============================================================
    match /courts/{id} {
      // Own rows and organizers only: a check-in says where a member was, and when.
      allow read: if isOrganizerRole() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // A check-in visit: the member's own, near the court, on the {uid}_{courtKey}_{YYYYMMDD} id.
      allow create, update: if isAuthenticated() &&
        request.resource.data.category == 'visit' &&
        request.resource.data.uid == request.auth.uid &&
        id.matches(request.auth.uid + '_' + request.resource.data.court_key + '_[0-9]{8}') &&
        request.resource.data.dist_m is number && request.resource.data.dist_m <= 400 &&
        request.resource.data.created_at is timestamp;
      // A report: the member's own, or a signed-out visitor's (not_a_member / anonymous, pays nobody).
      allow create: if
        request.resource.data.category == 'report' &&
        request.resource.data.sub_category in ['condition', 'waiting_board', 'queue'] &&
        request.resource.data.court_key is string &&
        request.resource.data.photo_paths is list && request.resource.data.photo_paths.size() <= 3 &&
        request.resource.data.note is string &&
        (request.resource.data.sub_category != 'condition' || request.resource.data.note.size() > 0) &&
        (
          (isAuthenticated() && request.resource.data.uid == request.auth.uid) ||
          (request.resource.data.uid == 'not_a_member' && request.resource.data.user_name == 'anonymous')
        );
      allow delete: if false;
    }

    // ===============================================================
    // Services — the catalog. Organizers maintain it; a provider maintains their own offers.
    // ===============================================================
    // Coaching needs the coach role, stringing the stringer role; no other category for a provider.
    function providerMayOffer(data) {
      return data.provider_id == request.auth.uid &&
        ((data.category == 'coaching' && hasRole(request.auth.uid, 'coach')) ||
         (data.category == 'stringing' && hasRole(request.auth.uid, 'stringer')));
    }

    match /services/{id} {
      allow read: if true;
      allow create: if isOrganizerRole() || (isAuthenticated() &&
        providerMayOffer(request.resource.data) &&
        request.resource.data.redeem_booking_id == '' && request.resource.data.booking_count == 0 &&
        request.resource.data.active == true);
      // redeem_booking_id and booking_count belong to the booking callables (a group lesson's one
      // redeemed seat; how often the offer was booked, which orders a stringer's offers).
      allow update: if isOrganizerRole() || (isAuthenticated() &&
        resource.data.provider_id == request.auth.uid && providerMayOffer(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['redeem_booking_id', 'booking_count', 'created_at']));
      allow delete: if false;
    }

    // Bookings: written only by the booking callables. Readable by the member, its provider
    // (provider_id is the provider's uid) and organizers.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || resource.data.provider_id == request.auth.uid || isOrganizerRole());
      allow write: if false;
    }

    // ===============================================================
    // Signed-out forms: volunteer sign-ups and the mailing list.
    // ===============================================================
    match /volunteer_signups/{signupId} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'activity', 'note', 'uid', 'user_name', 'created_at']) &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() < 320 &&
        request.resource.data.activity is string && request.resource.data.activity.size() > 0 && request.resource.data.activity.size() < 60 &&
        request.resource.data.note is string && request.resource.data.note.size() < 2000 &&
        (
          (isAuthenticated() && request.resource.data.uid == request.auth.uid) ||
          (request.resource.data.uid == 'not_a_member' && request.resource.data.user_name == 'anonymous')
        );
      allow read, update, delete: if isOrganizerRole();
    }

    // The one mailing list. A member owns ONE row keyed by their uid (member: true); a visitor's
    // auto-id row carries uid 'not_a_member' / user_name 'anonymous' / member: false (a real uid can
    // never equal it, so it can't be forged).
    match /mailing_list/{subscriberId} {
      function validSubscriber() {
        return request.resource.data.keys().hasOnly(['email', 'uid', 'user_name', 'member', 'source', 'created_at']) &&
          request.resource.data.email is string &&
          request.resource.data.email.size() > 0 &&
          request.resource.data.email.size() < 320 &&
          request.resource.data.source is string;
      }
      allow create, update: if isAuthenticated() && subscriberId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid && request.resource.data.member == true && validSubscriber();
      allow create: if request.resource.data.uid == 'not_a_member' && request.resource.data.user_name == 'anonymous' &&
        request.resource.data.member == false && validSubscriber();
      allow get: if isAuthenticated() && subscriberId == request.auth.uid;
      allow read, update, delete: if isOrganizerRole();
    }

    // ===============================================================
    // Notifications — server-created; the recipient marks read (read_at) or deletes.
    // ===============================================================
    match /notifications/{id} {
      allow create: if false;
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // Marketplace Listings
    // ===============================================================
    match /listings/{id} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'available' &&
        request.resource.data.category in ['sell', 'rent', 'trade'] &&
        request.resource.data.sub_category == request.resource.data.category;
      allow update: if (isOwner(resource.data.uid) || isOrganizerRole()) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(resource.data.uid);
    }

    // ===============================================================
    // Task Claims — one row per claim; organizers review.
    // ===============================================================
    match /task_claims/{id} {
      // Own claims and organizers only (reviewer notes, invitee names).
      allow read: if isOrganizerRole() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.category in ['volunteer', 'ambassador', 'host'] &&
        request.resource.data.sub_category == request.resource.data.category &&
        request.resource.data.status == 'pending';
      allow update: if isOrganizerRole();
      allow delete: if false;
    }

    // Connections: written ONLY by Cloud Functions — a client that could create these could grant
    // itself anyone's phone number.
    match /connections/{pair} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Marker: "this person has a live marketplace listing, so a buyer may contact them."
    match /public_contacts/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Consolidation archive — Admin SDK only, never reachable from a client.
    match /_archive_database_consolidation/{document=**} {
      allow read, write: if false;
    }
  }
}
