rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid == "7PvfzNtDmsOq5GLMieId7QRT7wH3";
    }

    function isGlobalEventCreator() {
      return isAuthenticated() &&
        (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/preferences/$(request.auth.uid)).data.event_creator == true
        );
    }

    function isCreatorOfEvent(eventId) {
      return isAuthenticated() &&
        (
          isGlobalEventCreator() ||
          get(/databases/$(database)/documents/events/$(eventId)).data.creator_id == request.auth.uid
        );
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ===============================================================
    // Stats Collection
    // ===============================================================
    match /stats/{userId} {
      allow read: if true;
      // Owners may self-create only an all-zero scoring baseline (signup / bootstrap).
      allow create: if isGlobalEventCreator() ||
        (isOwner(userId) &&
          request.resource.data.leaguePoints26 == 0 &&
          request.resource.data.wins == 0 &&
          request.resource.data.loses == 0 &&
          request.resource.data.matchesPlayed == 0 &&
          request.resource.data.tournamentsPlayed == 0);
      // Owners may only edit profile fields; scoring fields are organizer-only.
      allow update: if isGlobalEventCreator() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['skill_level', 'tournament_preference', 'name', 'user_id']));
      allow delete: if false;
    }

    // ===============================================================
    // Preferences Collection
    // ===============================================================
    match /preferences/{userId} {
      allow read: if true;
      // event_creator may never be self-granted — only the super admin sets it.
      allow create: if isOwner(userId) && request.resource.data.event_creator == false;
      allow update: if isSuperAdmin() ||
        (isOwner(userId) &&
          request.resource.data.event_creator == resource.data.event_creator);
      allow delete: if false;
    }

    // ===============================================================
    // Events Collection
    // ===============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isGlobalEventCreator();
      allow delete: if false;
    }

    // ===============================================================
    // Event Participants
    // ===============================================================
    match /event_participants/{docId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        (
          request.resource.data.user_id == request.auth.uid ||
          isCreatorOfEvent(request.resource.data.event_id)
        ) &&
        request.resource.data.event_id is string &&
        request.resource.data.createdAt is string;

      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
    }

    // ===============================================================
    // Tournament Matches (draw + results)
    // ===============================================================
    match /tournament_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isCreatorOfEvent(request.resource.data.event_id);
      // Organizer may edit anything; the two match players may edit ONLY the scheduling fields
      // (propose/confirm/reschedule/ask-organizer). Scores, players and advancement stay
      // organizer-only.
      allow update: if isCreatorOfEvent(resource.data.event_id)
        || (
          isAuthenticated()
          && (request.auth.uid == resource.data.player_1_user_id || request.auth.uid == resource.data.player_2_user_id)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['schedule_status', 'proposed_date', 'proposed_slot', 'proposed_by', 'schedule_requested'])
        );
      allow delete: if isCreatorOfEvent(resource.data.event_id);
    }

    // ===============================================================
    // Score Submissions (player-submitted scores, pending creator confirm)
    // ===============================================================
    match /score_submissions/{docId} {
      allow read: if isAuthenticated();

      // A submission is only a *request* — the event creator confirms it before it counts,
      // so the creator is the integrity gate. We require a signed-in user submitting as
      // themselves; the client gates who can see the Submit button (match players/teammates).
      allow create: if isAuthenticated() &&
        request.resource.data.submitted_by == request.auth.uid &&
        request.resource.data.event_id is string &&
        request.resource.data.match_id is string;

      // The submitter may retract; the event creator confirms/rejects by deleting.
      allow delete: if isAuthenticated() &&
        (
          resource.data.submitted_by == request.auth.uid ||
          isCreatorOfEvent(resource.data.event_id)
        );

      allow update: if false;
    }

    // ===============================================================
    // Court Suggestions (public "Suggest an Improvement" feedback)
    // ===============================================================
    match /court_suggestions/{id} {
      // Anyone (incl. logged-out) may submit, with basic validation to limit abuse.
      // Field shape must match what SuggestImprovementModal writes: `types` (a non-empty
      // list of issue categories) + `court` (a string; '' for a website suggestion).
      allow create: if
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() < 5000 &&
        request.resource.data.types is list &&
        request.resource.data.types.size() > 0 &&
        request.resource.data.court is string &&
        request.resource.data.status == 'open';
      // Only organizers read / triage / update image_status / delete.
      allow read, update, delete: if isGlobalEventCreator();
    }

    // ===============================================================
    // Notifications (organizer alerts — e.g. player scheduling requests)
    // ===============================================================
    match /notifications/{id} {
      // A signed-in user may create a notification addressed to someone (e.g. a player
      // asking the organizer to schedule). Kept generic for future warnings/messages.
      allow create: if isAuthenticated() &&
        request.resource.data.recipient_id is string &&
        request.resource.data.created_at is string &&
        request.resource.data.requested_by == request.auth.uid;
      // Only the recipient may read, mark-read, or clear their notifications.
      allow read, update, delete: if isAuthenticated() &&
        resource.data.recipient_id == request.auth.uid;
    }

    // ===============================================================
    // Round Robin drafts (creator's pre-generation group arrangement + withdrawals)
    // ===============================================================
    match /rr_drafts/{id} {
      allow read: if isAuthenticated();
      // Only the event's creator may write the draft. Covers create/update (event_id in the
      // incoming data) and delete (event_id on the existing doc).
      allow write: if isAuthenticated() &&
        (
          (request.resource != null && isCreatorOfEvent(request.resource.data.event_id)) ||
          (resource != null && isCreatorOfEvent(resource.data.event_id))
        );
    }

    // Deferred (built with the Messages release): player conduct reports
    // { reporter_uid, match_id, opponent_uid, reason, detail, created_at, status } — organizer read only.
    // match /player_reports/{id} {
    //   allow create: if isAuthenticated() && request.resource.data.reporter_uid == request.auth.uid;
    //   allow read, update, delete: if isGlobalEventCreator();
    // }

    // ===============================================================
    // Reserves Participants
    // ===============================================================
    match /reserves_participants/{docId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.event_id is string &&
        request.resource.data.createdAt is string;

      allow update: if isCreatorOfEvent(resource.data.event_id);

      allow delete: if isAuthenticated() &&
        (
          resource.data.user_id == request.auth.uid ||
          isCreatorOfEvent(resource.data.event_id)
        );
    }

  }
}
