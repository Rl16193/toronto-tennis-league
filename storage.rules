rules_version = '2';

// NOTE: deploying this REPLACES the bucket's current console rules. Paste into
// Firebase Console → Storage → Rules → Publish (or `firebase deploy --only storage`).
service firebase.storage {
  match /b/{bucket}/o {

    // Bare `allow` blocks only match their own path segment, not descendants — this wildcard
    // is required for reads to actually cascade to every object (avatars, court suggestion
    // photos, gallery, etc).
    match /{allPaths=**} {
      allow read: if true;
    }

    // "Suggest an Improvement" photos: signed-in owner only, images under 5 MB.
    match /court_suggestions/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Profile avatars: signed-in owner only, images under 5 MB.
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Tasks tab "Submit a Photo" (condition / waiting board / queue): signed-in owner only,
    // images under 5 MB.
    match /court_reports/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Marketplace listing photos: signed-in owner only, images under 5 MB. Scanned by the
    // SafeSearch function in functions/index.js, same as court photos and avatars.
    match /listings/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Anonymous "Report" photos (logged-out reporters) land under the fixed `anon/` prefix.
    // No auth required, still image-only and size-capped to limit abuse.
    match /court_reports/anon/{fileName} {
      allow write: if request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
